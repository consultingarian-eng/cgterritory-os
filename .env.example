# CGTerritory settings. Copy this file to .env for a local run:
#     cp .env.example .env
# On Railway, put the same names in Service -> Variables instead (never upload .env).
#
# Values marked [SECRET] are passwords or keys: never commit them, paste them
# into chat, or show them in a screenshot. .env is listed in .gitignore.
#
# Leave a variable out (or blank) if you don't use it. Business settings
# (offices, depots, regions, time zone, brand) are NOT here: they live in
# config/territory.json, which holds no secrets. See docs/SETUP.md.

# ── Required ─────────────────────────────────────────────────────────────────

# [SECRET] MongoDB connection string, including the database name after the "/".
# Locally use a SEPARATE database, e.g. .../cgterritory_dev, never the live one.
MONGODB_URI=

# [SECRET] Signs sign-in sessions. At least 32 random characters, or the server
# refuses to start. Make one with:  openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=

# The address people open, with no trailing slash. Used in invite and reset links.
# Locally: http://localhost:3000   Live: https://territory.yourcompany.co.uk
APP_URL=

# The first admin account (created at start-up only while there are NO accounts
# at all), and the address told about failed backups.
ADMIN_EMAIL=
ADMIN_NAME=

# [SECRET] Password for that first admin, used once. Remove it from your
# variables after the first sign-in (and change the password in the app).
# Ignored once any account exists. Locked out later? scripts/admin-reset-link.js
INITIAL_ADMIN_PASSWORD=

# ── Running locally ──────────────────────────────────────────────────────────

# Port to listen on. Railway sets this itself; leave it out there.
PORT=3000

# "development" lets the sign-in cookie work over plain http://localhost.
# Leave it out on Railway (the cookie must stay secure-only there).
NODE_ENV=development

# Optional: a different settings file instead of config/territory.json.
CGT_SETTINGS_FILE=

# Optional: the board's time zone, e.g. Europe/London. Wins over "timezone" in
# config/territory.json (default America/New_York). Every "today" follows it.
APP_TIMEZONE=

# Leave empty: X-Forwarded-For is then believed only from a private/loopback
# peer (a host's proxy such as Railway's), never from a browser connecting
# directly. 0 = never trust it; a number = that many proxy hops. The sign-in
# throttle uses the client address this produces.
TRUST_PROXY=

# ── Backups and street maps: Cloudflare R2 or any S3-compatible bucket ───────
# Strongly recommended: without these there are NO backups. Leave them out locally.
CGT_S3_ENDPOINT=
CGT_S3_BUCKET=
# [SECRET]
CGT_S3_ACCESS_KEY_ID=
# [SECRET]
CGT_S3_SECRET_ACCESS_KEY=
# "auto" for R2 (the default); your bucket's region for others.
CGT_S3_REGION=
# [SECRET] Encrypts each night's backup (64 hex characters from
# `openssl rand -hex 32`, or a long passphrase). Keep a copy outside Railway:
# without it the backups can't be restored. Recommended.
BACKUP_ENCRYPTION_KEY=
# "off" = the app never deletes old backup nights; let a lifecycle rule in the
# bucket do it, and give the app a key that can't delete. Default: on (30 days).
BACKUP_PRUNE=

# ── Email (invites, password resets, backup alerts) ──────────────────────────
# [SECRET] SendGrid API key with Mail Send permission.
SENDGRID_API_KEY=
# A sender address verified in SendGrid, e.g. territory@yourcompany.co.uk
MAIL_FROM=
# The name emails come from. Defaults to the app name in config/territory.json.
MAIL_FROM_NAME=

# ── Geocoding (addresses -> map positions) ───────────────────────────────────
# A contact (email or web address) sent to OpenStreetMap's free services, as
# their usage policies ask. Defaults to ADMIN_EMAIL.
GEOCODER_CONTACT=

# ── AI: permit research and reading territory lists ──────────────────────────
# [SECRET] Anthropic API key. Set a monthly spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=
# [SECRET] Optional fallback search for permit research.
BRAVE_SEARCH_API_KEY=
# The model every AI call uses. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=
# Most AI calls the whole board may make per day (default 200; 0 = AI off).
AI_DAILY_LIMIT=

# ── Sales (map, sale pins, Balance board). Pick ONE source. ──────────────────
# A) A Google Sheet, read with a service account that has view access to it.
#    The id is the long part of the sheet's address between /d/ and /edit.
SALES_SHEET_ID=
#    The tab's gid (the number after gid= in its address). Blank = first tab.
SALES_SHEET_GID=
#    [SECRET] The service account's JSON key, pasted as one line.
GOOGLE_SHEETS_CREDENTIALS=
# B) [SECRET] Any CSV over HTTPS, e.g. a sheet "published to the web" as CSV.
#    Anyone with this link can read your sales, so treat it as a secret.
SALES_CSV_URL=
# C) A CSV file on disk. For a local try: samples/sales.sample.csv
SALES_CSV_FILE=

# ── Your field app (worked doors) ────────────────────────────────────────────
# [SECRET] Shared secret your field app sends in the x-service-token header.
# At least 24 random characters (openssl rand -hex 32). Unset = integration off.
FIELD_APP_TOKEN=
# Optional: an address on your field app that pushes its latest doors when
# asked (powers the "Sync doors" button). Must be https:// (plain http only
# for localhost), because FIELD_APP_TOKEN is sent to it. See docs/DATA.md.
FIELD_APP_SYNC_URL=

# ── Walking routes ───────────────────────────────────────────────────────────
# Your own (or a paid) Overpass server, always tried first. See docs/ROUTES.md.
OVERPASS_URL=
# Longest one lap may take, in minutes (45 to 240). Default 120.
ROUTE_LAP_MAX_MIN=
# How many areas may download their street maps at the same time (default 2).
ROUTE_COLD_JOBS=
# US parcel data only (see docs/ROUTES.md): homes counted per building up to
# this number (default 6); condos "skip" or "count" (default skip); apartment
# buildings with this many units or more skipped (default 9); "off" stops
# vacant/commercial lots removing buildings (default on).
UNIT_CAP=
UNIT_POLICY_CONDOS=
UNIT_POLICY_APT_SKIP_MIN=
UNIT_POLICY_SUPPRESS=

# ── Scripts only (set on the command line, not on Railway) ───────────────────
# DRY_RUN=1          preview what a loader would write, without writing
#                    (or pass --dry-run, which works the same on Windows)
# WITH_DAYS=1        scripts/import-hubs.js also sets each area's delivery day
#                    (or pass --with-days)
# CGT_DEV_MEM=1      set by `npm run dev:mem` for its own child processes; don't set it
# RAW_CACHE=<dir>    scripts/parcel-check.js keeps the Overpass download on disk
# CGT_EMAIL / CGT_PASSWORD   [SECRET] an admin login, for scripts/bulk-permit-research.js
